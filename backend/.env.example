# =============================================================================
# AgentIQ Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / Server
# -----------------------------------------------------------------------------

# Bearer token used for local development auth. Change before any shared deploy.
DEV_JWT=dev-token-change-me

# AUTH-1: secret used to sign/verify user-login JWTs (HS256). REQUIRED in
# production — when ENVIRONMENT=production and this is unset, JWT issuance fails
# closed rather than signing with the dev fallback. Generate a strong random
# value (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me

# Deployment environment: "production" enforces JWT_SECRET and fails the invite
# endpoint closed when no email provider is configured. Unset/anything else =
# dev/test behaviour.
ENVIRONMENT=

# PostgreSQL connection string. ./run.sh --db <dev|prod> picks one of the two
# URLs below and exports it as DATABASE_URL at launch (it wins because the app
# loads .env with override=False). Leave DATABASE_URL blank when using run.sh;
# set it directly only for tooling outside run.sh (e.g. `alembic upgrade head`).
DEV_DATABASE_URL=
PROD_DATABASE_URL=
DATABASE_URL=

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Ingestion mode: "offline" (fixture data) or "live" (real connectors).
INGEST_MODE=offline

# Track B runner mode: "subprocess" or "in_process".
TRACKB_RUNNER_MODE=offline

# Feature flag: enable inferred entity relationships (T3-S13-A).
INFERRED_RELATIONSHIPS_ENABLED=

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------

# Anthropic API key for LLM enrichment features. Optional — deterministic
# fallbacks run without it.
ANTHROPIC_API_KEY=

# =============================================================================
# OLD WAY — Direct connector credentials (still used by the discovery pipeline)
# =============================================================================

# Salesforce
SF_CLIENT_ID=
SF_USER=

# Jira
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=
JIRA_TOKEN=

# ServiceNow
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USER=
SERVICENOW_PASS=

# nCino
NCINO__CLIENT_ID=
NCINO_USER=

# STRS Benefits
STRS_CLIENT_ID=
STRS_USER=

# LoanStar
LS_CLIENT_ID=
LS_USER=

# =============================================================================
# NEW WAY — OAuth framework (CONNECTOR_AUTH_CONFIGS in backend/app/auth/configs.py)
# =============================================================================

# Shared callback URL — must be registered with every authorization_code provider.
OAUTH_REDIRECT_URI=https://your-domain/api/connectors/oauth/callback

# Salesforce-specific OAuth redirect URI (overrides OAUTH_REDIRECT_URI for SF).
SALESFORCE_OAUTH_REDIRECT_URI=https://your-domain/api/connectors/oauth/callback

# Fernet key for encrypting access_token and refresh_token at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_VAULT_KEY=

# Timeout in seconds for outbound OAuth HTTP calls (default: 30).
OAUTH_HTTP_TIMEOUT_SECONDS=30

# Seconds before token expiry at which auto-refresh is triggered (default: 300 = 5 min).
REFRESH_THRESHOLD_SECONDS=300

# =============================================================================
# LIC-1 — Offline license key
# =============================================================================
# The signed license key issued by CloudFulcrum. On first start the app stores
# it in the DB (admin License page can update it later). Leave empty for an
# unlicensed (read-only) install.
LICENSE_KEY=
# Optional override for the trusted Ed25519 PUBLIC verification key (PEM).
# Lets you rotate the root of trust WITHOUT a code change/release — same pattern
# as the secrets above. When unset, the baked-in CLOUDFULCRUM_PUBLIC_KEY is used.
# This is the PUBLIC key only; the private signing key never leaves CloudFulcrum.
LICENSE_PUBLIC_KEY=
# Periodic re-validation interval in hours (default: 12).
LICENSE_CHECK_INTERVAL_HOURS=12

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=your_secret_here

# ServiceNow
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=your_secret_here

# Jira + Confluence — both use a single shared Atlassian OAuth app
# Register one app at https://developer.atlassian.com/ and use its client ID for both connectors.
ATLASSIAN_CLIENT_ID=your_atlassian_client_id_here
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=your_secret_here

# Confluence
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=your_secret_here

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=your_secret_here

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=your_secret_here

# SAP
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=your_secret_here

# Dynamics 365
DYNAMICS365_CLIENT_ID=
DYNAMICS365_CLIENT_SECRET=your_secret_here

# nCino (new OAuth framework — not yet in configs.py)
NCINO_CLIENT_ID=
NCINO_CLIENT_SECRET=

# PSS (new OAuth framework — not yet in configs.py)
PSS_CLIENT_ID=
PSS_SECRET_KEY=

# =============================================================================
# Track 2 database connectors
# =============================================================================

# Oracle DB operational signal ingestor
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_DATABASE=ORCL
ORACLE_DB_USERNAME=
ORACLE_DB_PASSWORD=

# PostgreSQL operational signal ingestor
POSTGRESQL_HOST=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=postgres
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=

# =============================================================================
# Transactional email (CS-3) — app/email_service.py
# =============================================================================
# Provider: 'smtp' for Office 365 / generic SMTP. With no SMTP credentials
# configured, email sends are logged and return False; auth flows still succeed.
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@cloudfulcrum.com
EMAIL_FROM_NAME=AgentIQ
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
# Base URL used to build invite / password-reset links in emails, e.g.
# https://app.agentiq.example (no trailing slash). Defaults to localhost in dev.
PUBLIC_HOSTNAME=http://localhost:3000
# Public backend URL used to build org-approval action links in the admin email
# (AUTH-2). REQUIRED in production — if unset, links point to localhost and the
# admin cannot approve orgs without direct DB access. Must be the externally
# reachable base URL of the backend, e.g. https://api.agentiq.example
AGENTIQ_BACKEND_URL=
# Email address that receives new org approval request emails (AUTH-2).
# REQUIRED in production — if unset, emails go to the hardcoded default
# (agentiqadmin@dwpglobal.com) which may not be the correct inbox.
AGENTIQ_ADMIN_EMAIL=

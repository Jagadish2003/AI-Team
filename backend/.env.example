# OAuth connector client secrets — set these before starting the app in production.
# Each value is the actual client secret for the corresponding connector.
# See backend/app/auth/README.md for the secret_key naming convention.
SALESFORCE_CLIENT_SECRET=
SERVICENOW_CLIENT_SECRET=
JIRA_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
CONFLUENCE_CLIENT_SECRET=
SLACK_CLIENT_SECRET=
SAP_CLIENT_SECRET=
D365_CLIENT_SECRET=

# Set to 1 in production to enforce fail-fast secret validation at startup.
REQUIRE_CONNECTOR_SECRETS=

# Timeout in seconds for outbound OAuth HTTP calls (default: 30).
OAUTH_HTTP_TIMEOUT_SECONDS=30

# =============================================================================
# AgentIQ Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / Server
# -----------------------------------------------------------------------------

# Bearer token used for local development auth. Change before any shared deploy.
DEV_JWT=dev-token-change-me

# AUTH-1: secret used to sign/verify user-login JWTs (HS256). REQUIRED in
# production — when ENVIRONMENT=production and this is unset, JWT issuance fails
# closed rather than signing with the dev fallback. Generate a strong random
# value (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me

# Deployment environment: "production" enforces JWT_SECRET and fails the invite
# endpoint closed when no email provider is configured. Unset/anything else =
# dev/test behaviour.
ENVIRONMENT=

# PostgreSQL connection string. ./run.sh --db <dev|prod> picks one of the two
# URLs below and exports it as DATABASE_URL at launch (it wins because the app
# loads .env with override=False). Leave DATABASE_URL blank when using run.sh;
# set it directly only for tooling outside run.sh (e.g. `alembic upgrade head`).
DEV_DATABASE_URL=
PROD_DATABASE_URL=
DATABASE_URL=

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Ingestion mode: "offline" (fixture data) or "live" (real connectors).
INGEST_MODE=offline

# Track B runner mode: "subprocess" or "in_process".
TRACKB_RUNNER_MODE=offline

# Feature flag: enable inferred entity relationships (T3-S13-A).
INFERRED_RELATIONSHIPS_ENABLED=

# -----------------------------------------------------------------------------
# LLM / Model Provider Gateway (R16-D1)
# -----------------------------------------------------------------------------

# R16-D2 T4 — Hosted model provider credential.
# This is the required credential config key for the default 'hosted' provider.
# It is read from config/secrets only (never hardcoded) and is never logged.
# Optional for local dev — deterministic fallbacks run without it; required to
# enable live LLM enrichment via the hosted provider. Replace the placeholder
# with a real key (e.g. sk-ant-...) in your local .env or secrets manager.
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# R16-D2 T4 — Optional hosted-provider overrides (non-secret).
# MODEL_NAME pins a specific model version; leave blank to use the default.
# ANTHROPIC_API_URL overrides the hosted endpoint; leave blank for the default
# (https://api.anthropic.com/v1/messages).
MODEL_NAME=
ANTHROPIC_API_URL=

# R16-D1 — Model Provider Gateway: which provider handles text generation.
# Valid values: 'hosted' (Anthropic API, default), 'in_boundary' (R17-D1),
# 'customer_tenant' (R17-D2).
# Select 'in_boundary' to route generation through the customer-operated model
# endpoint, or 'customer_tenant' to route it through the customer's managed
# in-tenant model service (e.g. Azure OpenAI) configured below.
# Leave blank to use the default ('hosted').
MODEL_GENERATION_PROVIDER=hosted

# R16-D1 — Model Provider Gateway: which provider handles embedding calls.
# Resolved independently from MODEL_GENERATION_PROVIDER — a customer can run
# hosted generation but in-boundary embeddings, or vice versa.
# Valid values: 'hosted' (default), 'in_boundary' (R17-D1),
# 'customer_tenant' (R17-D2).
MODEL_EMBEDDING_PROVIDER=hosted

# R17-D1 T4 — In-boundary model provider config.
# The customer operates this endpoint inside their own network. CloudFulcrum
# owns the AgentIQ adapter code only; it does not operate the customer's GPU or
# model-serving infrastructure.
#
# Option A: provide a common OpenAI-compatible base URL. The adapter derives:
#   generation: /v1/chat/completions
#   embedding:  /v1/embeddings
# Leave blank unless in_boundary mode is actually in use — a non-empty value
# makes the provider report its endpoint as "configured" at startup even on a
# developer machine where no such endpoint exists. Example value (commented):
#   IN_BOUNDARY_BASE_URL=https://models.customer.internal
IN_BOUNDARY_BASE_URL=

# Option B: override either endpoint independently if the customer's server
# exposes different URLs for generation and embedding.
IN_BOUNDARY_GENERATION_ENDPOINT=
IN_BOUNDARY_EMBEDDING_ENDPOINT=

# Secret bearer token / API key for the customer-operated model endpoint.
# Keep this in local .env or a secrets manager; never commit a real value.
IN_BOUNDARY_API_KEY=ib-YOUR_KEY_HERE

# Optional common model fallback plus independent generation/embedding pins.
# Embedding must be configurable in-boundary too; otherwise text can still
# leave the customer boundary through vectorization.
IN_BOUNDARY_MODEL=
IN_BOUNDARY_GENERATION_MODEL=
IN_BOUNDARY_EMBEDDING_MODEL=

# R17-D2 T1/T4 — Customer-tenant model provider config.
# The customer operates a MANAGED model service inside their own cloud tenant
# (canonical example: Azure OpenAI provisioned in their subscription). This
# differs from in-boundary mode in what the customer operates — a managed cloud
# service rather than a model they run themselves. CloudFulcrum owns the AgentIQ
# adapter code only; the customer owns, controls, and can revoke the endpoint and
# the credential into it.
#
# Endpoint base (Azure OpenAI resource root). The adapter builds per-deployment
# URLs of the form:
#   {endpoint}/openai/deployments/{deployment}/chat/completions?api-version=...
#   {endpoint}/openai/deployments/{deployment}/embeddings?api-version=...
# Leave blank unless customer_tenant mode is actually in use. Example (commented):
#   CUSTOMER_TENANT_ENDPOINT=https://my-resource.openai.azure.com
CUSTOMER_TENANT_ENDPOINT=

# Managed-service API version (Azure OpenAI query parameter). Defaults to a
# stable GA version when blank; override to move to a newer version.
CUSTOMER_TENANT_API_VERSION=

# Deployment names. Common fallback plus independent generation/embedding pins.
# Embedding must be configurable in-tenant too; otherwise text can still leave
# the customer's boundary through vectorization.
CUSTOMER_TENANT_DEPLOYMENT=
CUSTOMER_TENANT_GENERATION_DEPLOYMENT=
CUSTOMER_TENANT_EMBEDDING_DEPLOYMENT=

# Optional full-URL overrides for a managed endpoint that does not follow the
# Azure deployment-path convention. When set, the value is used verbatim.
CUSTOMER_TENANT_GENERATION_ENDPOINT=
CUSTOMER_TENANT_EMBEDDING_ENDPOINT=

# Secret credential into the customer's tenant (Azure OpenAI api-key). Handled
# with vault-grade hygiene: never logged, never hardcoded, resolved live so a
# customer rotation/revocation takes effect without a restart.
#
# R17-D2 T2: in PRODUCTION this credential lives ONLY in the Fernet-encrypted
# credential vault (the `credentials` table, keyed per org, same as connector
# OAuth tokens) — set it via the vault, not here, and leave this blank so
# revoking the vault credential fully revokes access. This env var is a
# DEV/STANDALONE fallback only, used when no vaulted credential exists for the
# org. Keep it in local .env or a secrets manager; never commit a real value.
CUSTOMER_TENANT_API_KEY=ct-YOUR_KEY_HERE

# =============================================================================
# Connector live ingestion
#
# Salesforce, Jira, and ServiceNow connect per-user via the Integration Hub
# OAuth flow; their access tokens live in the credential vault (DB) and their
# instance/site URLs are captured at connect time (DB). The discovery run sources
# both from the DB per org — no SF_*/JIRA_*/SERVICENOW_* env vars needed.
#
# nCino and STRS run against a Salesforce org and automatically use the connected
# Salesforce OAuth credentials from the DB. Set the optional overrides below ONLY
# to point them at a different instance/token. (The previous token-generation CLI
# under backend/token_generation/ has been removed.)
# =============================================================================

# nCino (optional override)
NCINO_INSTANCE_URL=
NCINO_ACCESS_TOKEN=

# STRS Benefits (optional override)
STRS_INSTANCE_URL=
STRS_ACCESS_TOKEN=

# =============================================================================
# NEW WAY — OAuth framework (CONNECTOR_AUTH_CONFIGS in backend/app/auth/configs.py)
# =============================================================================

# Shared callback URL — must be registered with every authorization_code provider.
OAUTH_REDIRECT_URI=https://your-domain/api/connectors/oauth/callback

# Frontend base URL the backend redirects to after the OAuth callback completes
# (CS-2 / AT-325). The backend appends /oauth/callback?connected=...&status=success
# on success, or /oauth/callback?status=error&code=... on failure. Leave blank to
# use a relative path (same-origin / reverse-proxied deploys). Set to the frontend
# origin (e.g. http://localhost:5173 in dev) when FE and BE are on different hosts.
OAUTH_FRONTEND_BASE_URL=

# Fernet key for encrypting access_token and refresh_token at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_VAULT_KEY=

# Dedicated HMAC secret for signing the OAuth `state` parameter (R17-D3 / AT-447).
# The org that initiates a connector OAuth flow is carried, HMAC-signed, in `state`
# and verified on callback so a callback can't be bound to the wrong tenant.
# Keep this SEPARATE from JWT_SECRET: rotating the session-signing key (e.g. after
# a suspected compromise) must not also break every in-flight OAuth flow. If unset,
# it falls back to JWT_SECRET for backward compatibility. Generate with:
#   openssl rand -hex 32
OAUTH_STATE_SECRET=

# DEV-ONLY: allow the OAuth callback to complete without a Bearer header (a
# provider's browser redirect carries none) so the live flow works on localhost.
# WARNING: never set this in a shared/staging/production deploy — it disables the
# callback's tenant-binding auth. It is FORCE-IGNORED when ENVIRONMENT=production.
OAUTH_CALLBACK_ALLOW_UNAUTH=

# Timeout in seconds for outbound OAuth HTTP calls (default: 30).
OAUTH_HTTP_TIMEOUT_SECONDS=30

# Seconds before token expiry at which auto-refresh is triggered (default: 300 = 5 min).
REFRESH_THRESHOLD_SECONDS=300

# =============================================================================
# LIC-1 — Offline license key
# =============================================================================
# The signed license key issued by CloudFulcrum. On first start the app stores
# it in the DB (admin License page can update it later). Leave empty for an
# unlicensed (read-only) install.
LICENSE_KEY=
# Optional override for the trusted Ed25519 PUBLIC verification key (PEM).
# Lets you rotate the root of trust WITHOUT a code change/release — same pattern
# as the secrets above. When unset, the baked-in CLOUDFULCRUM_PUBLIC_KEY is used.
# This is the PUBLIC key only; the private signing key never leaves CloudFulcrum.
LICENSE_PUBLIC_KEY=
# Periodic re-validation interval in hours (default: 12).
LICENSE_CHECK_INTERVAL_HOURS=12

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=your_secret_here

# ServiceNow
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=your_secret_here

# Jira + Confluence — both use a single shared Atlassian OAuth app
# Register one app at https://developer.atlassian.com/ and use its client ID for both connectors.
ATLASSIAN_CLIENT_ID=your_atlassian_client_id_here
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=your_secret_here

# Confluence
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=your_secret_here

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=your_secret_here

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=your_secret_here

# SAP
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=your_secret_here

# Dynamics 365
DYNAMICS365_CLIENT_ID=
DYNAMICS365_CLIENT_SECRET=your_secret_here

# Microsoft Teams (Microsoft Graph OAuth — R17-A1 / AT-434)
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=your_secret_here
# Microsoft Entra tenant for the Teams OAuth app: a tenant GUID (locks to one
# customer tenant), or "organizations" (any work/school tenant). Default:
# "organizations" — never "common" (Teams is a work/school product, no personal
# Microsoft accounts).
TEAMS_TENANT_ID=organizations

# nCino (new OAuth framework — not yet in configs.py)
NCINO_CLIENT_ID=
NCINO_CLIENT_SECRET=

# PSS (new OAuth framework — not yet in configs.py)
PSS_CLIENT_ID=
PSS_SECRET_KEY=

# =============================================================================
# Track 2 database connectors
# =============================================================================

# Oracle DB operational signal ingestor
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_DATABASE=ORCL
ORACLE_DB_USERNAME=
ORACLE_DB_PASSWORD=

# PostgreSQL operational signal ingestor
POSTGRESQL_HOST=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=postgres
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=

# =============================================================================
# Transactional email (CS-3) — app/email_service.py
# =============================================================================
# Provider: 'smtp' for Office 365 / generic SMTP. With no SMTP credentials
# configured, email sends are logged and return False; auth flows still succeed.
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@cloudfulcrum.com
EMAIL_FROM_NAME=AgentIQ
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
# Base URL used to build invite / password-reset links in emails, e.g.
# https://app.agentiq.example (no trailing slash). Defaults to localhost in dev.
PUBLIC_HOSTNAME=http://localhost:3000
# Public backend URL used to build org-approval action links in the admin email
# (AUTH-2). REQUIRED in production — if unset, links point to localhost and the
# admin cannot approve orgs without direct DB access. Must be the externally
# reachable base URL of the backend, e.g. https://api.agentiq.example
AGENTIQ_BACKEND_URL=
# Email address that receives new org approval request emails (AUTH-2).
# REQUIRED in production — if unset, emails go to the hardcoded default
# (agentiqadmin@dwpglobal.com) which may not be the correct inbox.
AGENTIQ_ADMIN_EMAIL=

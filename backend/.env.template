# =============================================================================
# AgentIQ Backend — Environment Variable Template
# -----------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values:
#   cp backend/.env.template backend/.env
# NEVER commit backend/.env — it is gitignored. This template contains
# placeholder values only and is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / Server
# -----------------------------------------------------------------------------

# Bearer token used for local development auth. Change before any shared deploy.
DEV_JWT=<random-string-for-local-dev-only>

# AUTH-1: secret used to sign/verify user-login JWTs (HS256). REQUIRED in
# production — when ENVIRONMENT=production and this is unset, JWT issuance fails
# closed rather than signing with the dev fallback.
JWT_SECRET=<generate: openssl rand -hex 32>

# Deployment environment: "production" enforces JWT_SECRET and fails the invite
# endpoint closed when no email provider is configured. Unset/anything else =
# dev/test behaviour.
ENVIRONMENT=

# PostgreSQL connection string (AT-288 / Fix 1).
# Alembic reads the same variable at migration time
# (backend/alembic.ini + migrations/env.py).
#
# ./run.sh --db <dev|prod> selects one of the two URLs below and exports it as
# DATABASE_URL at launch (it wins because the app loads .env with override=False).
# Leave DATABASE_URL itself blank when using run.sh; set it directly only for
# tooling that does not go through run.sh (e.g. `alembic upgrade head`).
DEV_DATABASE_URL=
PROD_DATABASE_URL=
DATABASE_URL=

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Ingestion mode: "offline" (fixture data) or "live" (real connectors).
INGEST_MODE=offline

# Track B runner mode: "subprocess" or "in_process".
TRACKB_RUNNER_MODE=offline

# Feature flag: enable inferred entity relationships (T3-S13-A).
INFERRED_RELATIONSHIPS_ENABLED=

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------

# Anthropic API key for LLM enrichment features. Optional — deterministic
# fallbacks run without it.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# =============================================================================
# OLD WAY — Direct connector credentials (still used by the discovery pipeline)
# =============================================================================

# Salesforce
SF_CLIENT_ID=<salesforce-client-id>
SF_USER=<salesforce-user>

# Jira
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=<jira-user>
JIRA_TOKEN=<jira-api-token>

# ServiceNow
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USER=<servicenow-user>
SERVICENOW_PASS=<servicenow-password>

# nCino
NCINO__CLIENT_ID=<ncino-client-id>
NCINO_USER=<ncino-user>

# STRS Benefits
STRS_CLIENT_ID=<strs-client-id>
STRS_USER=<strs-user>

# LoanStar
LS_CLIENT_ID=<loanstar-client-id>
LS_USER=<loanstar-user>

# =============================================================================
# NEW WAY — OAuth framework (CONNECTOR_AUTH_CONFIGS in backend/app/auth/configs.py)
# =============================================================================

# Shared callback URL — must be registered with every authorization_code provider.
OAUTH_REDIRECT_URI=https://your-domain/api/connectors/oauth/callback

# Salesforce-specific OAuth redirect URI (overrides OAUTH_REDIRECT_URI for SF).
SALESFORCE_OAUTH_REDIRECT_URI=https://your-domain/api/connectors/oauth/callback

# Fernet key for encrypting access_token and refresh_token at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_VAULT_KEY=<generate-fernet-key>

# Timeout in seconds for outbound OAuth HTTP calls (default: 30).
OAUTH_HTTP_TIMEOUT_SECONDS=30

# Seconds before token expiry at which auto-refresh is triggered (default: 300 = 5 min).
REFRESH_THRESHOLD_SECONDS=300

# Salesforce
SALESFORCE_CLIENT_ID=<salesforce-oauth-client-id>
SALESFORCE_CLIENT_SECRET=<salesforce-client-secret>

# ServiceNow
SERVICENOW_CLIENT_ID=<servicenow-oauth-client-id>
SERVICENOW_CLIENT_SECRET=<servicenow-client-secret>

# Jira + Confluence — both use a single shared Atlassian OAuth app
ATLASSIAN_CLIENT_ID=<atlassian-client-id>
JIRA_CLIENT_ID=<jira-oauth-client-id>
JIRA_CLIENT_SECRET=<jira-client-secret>

# Confluence
CONFLUENCE_CLIENT_ID=<confluence-oauth-client-id>
CONFLUENCE_CLIENT_SECRET=<confluence-client-secret>

# GitHub
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>

# Slack
SLACK_CLIENT_ID=<slack-oauth-client-id>
SLACK_CLIENT_SECRET=<slack-client-secret>

# SAP
SAP_CLIENT_ID=<sap-oauth-client-id>
SAP_CLIENT_SECRET=<sap-client-secret>

# Dynamics 365
DYNAMICS365_CLIENT_ID=<dynamics365-oauth-client-id>
DYNAMICS365_CLIENT_SECRET=<dynamics365-client-secret>

# nCino (new OAuth framework — not yet in configs.py)
NCINO_CLIENT_ID=<ncino-oauth-client-id>
NCINO_CLIENT_SECRET=<ncino-client-secret>

# PSS (new OAuth framework — not yet in configs.py)
PSS_CLIENT_ID=<pss-client-id>
PSS_SECRET_KEY=<pss-secret-key>

# =============================================================================
# Track 2 database connectors
# =============================================================================

# Oracle DB operational signal ingestor
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_DATABASE=ORCL
ORACLE_DB_USERNAME=<oracle-db-username>
ORACLE_DB_PASSWORD=<oracle-db-password>

# PostgreSQL operational signal ingestor
POSTGRESQL_HOST=
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=postgres
POSTGRESQL_USERNAME=<postgresql-username>
POSTGRESQL_PASSWORD=<postgresql-password>

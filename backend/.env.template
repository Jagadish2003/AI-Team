# =============================================================================
# AgentIQ Backend — Environment Variable Template
# -----------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values:
#   cp backend/.env.template backend/.env
# NEVER commit backend/.env — it is gitignored. This template contains
# placeholder values only and is safe to commit.
#
# INSTANCE CONFIGURATION ONLY (R17-D3 Addendum A, T13 / AC12).
# Everything in this file is legitimately per-deployment — never per-client:
# DATABASE_URL, CREDENTIAL_VAULT_KEY, CORS_ORIGINS, OAuth app registrations
# (client IDs/secrets + redirect URIs), SMTP, licensing, feature flags.
#
# PER-CLIENT CONNECTOR CREDENTIALS DO NOT BELONG HERE. Salesforce/Jira/
# ServiceNow OAuth tokens, Jira API tokens, ServiceNow passwords, and nCino/
# STRS tokens live ONLY in the per-org Fernet-encrypted credential vault
# (the `credentials` table), entered through the Integration Hub (OAuth
# Connect or the static-credential form). Adding a per-client secret to this
# file breaks multi-tenancy — two orgs on one instance would share it.
#
# CREDENTIAL_VAULT_KEY deliberately stays in the environment: it encrypts the
# vault's contents, so storing it in the database it protects would be
# circular. The key lives in env (or a secrets manager); everything the key
# protects lives in the vault.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / Server
# -----------------------------------------------------------------------------

# Bearer token used for local development auth. Change before any shared deploy.
DEV_JWT=dev-token-change-me

# Frontend base URL the backend redirects to after the OAuth callback completes.
OAUTH_FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated allowed CORS origins (frontend URL(s)).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Ingestion mode: "offline" (fixture data) or "live" (real connectors).
INGEST_MODE=offline

# Deployment inbound-network posture (R18-A3 T5 / AT-558):
#   standard          — the deployment can accept inbound HTTPS; the browser
#                       authorization-code OAuth flow (provider redirect →
#                       callback) works. Default.
#   no_public_inbound — the deployment exposes NO public inbound HTTPS (e.g. TCU
#                       and other security-conscious banks). The UI then hides the
#                       authorization-code Connect button for any connector that
#                       has an outbound-only mode (client_credentials/jwt_bearer/
#                       static) and shows the outbound setup path instead, so the
#                       customer can never start a flow that cannot complete.
# Anything unset/unrecognised falls back to "standard".
NETWORK_PROFILE=standard

# Track B runner mode: "in_process" or "subprocess".
TRACKB_RUNNER_MODE=in_process

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
# PostgreSQL connection strings. ./run.sh --db <dev|prod> selects one of the URLs
# below and exports it as DATABASE_URL at launch. Leave DATABASE_URL blank when
# using run.sh; set it directly only for tooling outside run.sh (e.g.
# `alembic upgrade head`).
DEV_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/agentiqdev
PROD_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/agentiqprod
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/agentiqdev-test
DATABASE_URL=

# -----------------------------------------------------------------------------
# LLM / Model Provider Gateway (R16-D1 / R17-D1)
# -----------------------------------------------------------------------------
# Anthropic API key for the default 'hosted' provider. Optional — deterministic
# fallbacks run without it; required to enable live LLM enrichment via hosted.
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Which provider serves text generation / embeddings. Resolved independently.
# Valid values: 'hosted' (default), 'in_boundary'.
MODEL_GENERATION_PROVIDER=hosted
MODEL_EMBEDDING_PROVIDER=hosted

# In-boundary provider config — only used when a provider above is 'in_boundary'.
# Leave blank on a machine with no such endpoint (a non-empty base URL makes the
# provider report itself "configured" at startup even when none exists).
IN_BOUNDARY_BASE_URL=
IN_BOUNDARY_GENERATION_ENDPOINT=
IN_BOUNDARY_EMBEDDING_ENDPOINT=
IN_BOUNDARY_API_KEY=
IN_BOUNDARY_MODEL=
IN_BOUNDARY_GENERATION_MODEL=
IN_BOUNDARY_EMBEDDING_MODEL=

# =============================================================================
# NEW WAY — OAuth framework (CONNECTOR_AUTH_CONFIGS in backend/app/auth/configs.py)
# =============================================================================

# Shared callback URL — must be registered with every authorization_code provider.
OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/oauth/callback

# DEV-ONLY: allow the OAuth callback to complete without a Bearer header so the
# live flow works on localhost. Never set in a shared/staging/production deploy;
# force-ignored when ENVIRONMENT=production.
OAUTH_CALLBACK_ALLOW_UNAUTH=1

# Fernet key for encrypting access_token and refresh_token at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_VAULT_KEY=<generate-fernet-key>

# Salesforce
SALESFORCE_INSTANCE=test.salesforce.com
SALESFORCE_CLIENT_ID=<salesforce-oauth-client-id>
SALESFORCE_CLIENT_SECRET=<salesforce-client-secret>

# ServiceNow
SERVICENOW_INSTANCE=<servicenow-instance>
SERVICENOW_CLIENT_ID=<servicenow-oauth-client-id>
SERVICENOW_CLIENT_SECRET=<servicenow-client-secret>

# Jira
JIRA_PROJECT_KEY=<jira-project-key>
JIRA_CLIENT_ID=<jira-oauth-client-id>
JIRA_CLIENT_SECRET=<jira-client-secret>

# Confluence
CONFLUENCE_CLIENT_ID=<confluence-oauth-client-id>
CONFLUENCE_CLIENT_SECRET=<confluence-client-secret>

# GitHub
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>

# Slack
SLACK_CLIENT_ID=<slack-oauth-client-id>
SLACK_CLIENT_SECRET=<slack-client-secret>

# Microsoft Teams (Microsoft Graph OAuth)
# Tenant GUID, or "organizations" (any work/school tenant). Default: organizations.
TEAMS_TENANT_ID=<teams-entra-tenant-id-or-organizations>
TEAMS_CLIENT_ID=<teams-oauth-client-id>
TEAMS_CLIENT_SECRET=<teams-client-secret>

# SharePoint (Microsoft Graph OAuth — R17-A2 / AT-462)
# Reuses the Teams Microsoft Graph app registration by default: leave the two
# vars below blank to inherit TEAMS_CLIENT_ID / TEAMS_TENANT_ID, or set them to
# point SharePoint at a dedicated Graph app/tenant.
SHAREPOINT_CLIENT_ID=<sharepoint-oauth-client-id-or-blank-to-reuse-teams>
SHAREPOINT_TENANT_ID=<sharepoint-entra-tenant-id-or-blank-to-reuse-teams>
# Required (per-connector convention). When reusing the Teams Graph app, set this
# to the same value as TEAMS_CLIENT_SECRET.
SHAREPOINT_CLIENT_SECRET=<sharepoint-client-secret>

# SAP
SAP_SUBDOMAIN=<sap-subdomain>
SAP_REGION=<sap-region>
SAP_CLIENT_ID=<sap-oauth-client-id>
SAP_CLIENT_SECRET=<sap-client-secret>

# Dynamics 365
DYNAMICS365_TENANT_ID=<dynamics365-entra-tenant-id>
DYNAMICS365_CLIENT_ID=<dynamics365-oauth-client-id>
DYNAMICS365_CLIENT_SECRET=<dynamics365-client-secret>

# nCino (new OAuth framework — not yet in configs.py)
NCINO_CLIENT_ID=<ncino-oauth-client-id>
NCINO_CLIENT_SECRET=<ncino-client-secret>

# PSS (new OAuth framework — not yet in configs.py)
PSS_CLIENT_ID=<pss-client-id>
PSS_SECRET_KEY=<pss-secret-key>

# -----------------------------------------------------------------------------
# Relationship mapping UI
# -----------------------------------------------------------------------------
# Feature flag: enable inferred entity relationships (T3-S13-A).
INFERRED_RELATIONSHIPS_ENABLED=true

# =============================================================================
# Transactional email (CS-3) — app/email_service.py
# =============================================================================
# Provider: 'smtp' for Office 365 / generic SMTP. With no SMTP credentials
# configured, email sends are logged and return False; auth flows still succeed.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_USE_STARTTLS=true
EMAIL_FROM=noreply@cloudfulcrum.com
EMAIL_FROM_NAME=AgentIQ
# Base URL used to build invite / password-reset / org-approved login links in
# emails (frontend URL). In a no-public-inbound deployment (R18-A3), set this to
# the INTERNAL deployment URL so internal admins/users reach the app from inside
# the network — see deployment/README.md "No-Public-Inbound Deployments".
PUBLIC_HOSTNAME=http://localhost:5173
# Email address that receives new org approval request emails (AUTH-2). Replace
# with the correct distribution list in production.
AGENTIQ_ADMIN_EMAIL=<admin-distribution-list>
# Backend URL used to build AUTH-2 org-approval (approve/reject) action links in
# the admin email. These links are clicked by an INTERNAL admin, so in a
# no-public-inbound deployment (R18-A3 T7) set this to the internal deployment URL
# (e.g. https://agentiq.internal.bank.local); no inbound exposure is required.
AGENTIQ_BACKEND_URL=http://localhost:8000

# =============================================================================
# License API
# =============================================================================
LICENSE_API_URL=https://<license-api-host>/prod/license

# MSP-B5 inverse finding: repeated operational loop with no matching runbook.
MSP_B5_DOCUMENTATION_GAP_FLOOR=5
MSP_B5_DOCUMENTATION_GAP_CONFIDENCE_CAP=0.65

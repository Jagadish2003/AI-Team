# =============================================================================
# AgentIQ Frontend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Backend API base URL. Defaults to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000

# Bearer token used for local development auth.
# Must match DEV_JWT in backend/.env.
VITE_DEV_JWT=dev-token-change-me
